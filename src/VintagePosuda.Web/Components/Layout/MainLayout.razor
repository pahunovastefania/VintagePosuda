@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>

        <footer class="app-footer px-4">
            <div class="footer-inner">
                <div class="footer-brand">
                    <img class="footer-logo" src="logo-vintage-posuda.svg" width="40" height="40" alt="" />
                    <div>
                        <div class="footer-title">Винтажная посуда</div>
                        <div class="footer-note">Каталог предметов, продаж и складских отчётов</div>
                    </div>
                </div>

                <nav class="footer-links" aria-label="Ссылки в нижней части сайта">
                    <a href="/">Каталог</a>
                    <a href="/reports">Отчёты</a>
                    <a href="/items/new">Добавить предмет</a>
                </nav>

                <div class="footer-meta">
                    <span>.NET 8</span>
                    <span>Blazor Server</span>
                    <span>EF Core</span>
                </div>
            </div>
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
