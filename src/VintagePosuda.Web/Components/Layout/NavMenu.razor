<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img class="brand-logo" src="logo-vintage-posuda.svg" alt="" />
            <span>Винтажная посуда</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Каталог
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="items/new">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Добавить предмет
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reports">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Отчёты
            </NavLink>
        </div>

        <hr class="text-secondary mx-3" />

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 small text-light">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span>
                    @(context.User.Identity?.Name ?? "Пользователь")
                </div>
                <div class="nav-item px-3">
                    <form method="post" action="/Account/Logout">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link btn btn-link text-start w-100 ps-0">
                            Выйти
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">Войти</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">Регистрация</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
