# =====================================================================
# Пример переменных окружения для docker-compose.
# Скопируйте в .env и заполните своими значениями. .env в git не коммитится.
# =====================================================================

# Учётная запись администратора, создаётся при первом запуске.
# В продакшене ОБЯЗАТЕЛЬНО задайте сильный пароль (≥ 8 символов, буквы + цифры).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Администратор
