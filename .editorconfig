# EditorConfig: согласованный стиль кода в проекте.
# Документация: https://editorconfig.org
# Этот файл выполняет требование ТЗ к соблюдению StyleCop/EditorConfig.

root = true

# Любые файлы
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown — иногда требуются висячие пробелы в конце строки для разрыва
[*.md]
trim_trailing_whitespace = false

# YAML/JSON — отступ 2 пробела
[*.{yml,yaml,json}]
indent_size = 2

# C# — детальные правила стиля
[*.cs]
indent_size = 4

# Современные правила оформления C# (StyleCop-совместимые)
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# var vs explicit type
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# this. и Me.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Скобки
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Именование: интерфейсы начинаются с I
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = prefix_interface_with_i

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public,internal,private,protected,protected_internal,private_protected

dotnet_naming_style.prefix_interface_with_i.required_prefix = I
dotnet_naming_style.prefix_interface_with_i.capitalization = pascal_case

# Современные конструкции C#
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
csharp_style_expression_bodied_methods = false:silent

# Razor-файлы — отступ 4 пробела для C# в @code, 2 для разметки
[*.razor]
indent_size = 4

# Файлы проектов и решений
[*.{csproj,sln,props,targets}]
indent_size = 2
